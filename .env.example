# Kall Me Environment Configuration Example

# Database Configuration
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=kallme_db
PG_PASSWORD=your_password
PG_PORT=5432
PG_SSL=false

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# TaskHub Integration Configuration
# Enable/disable integration endpoints (/api/integration/v1/*)
TASKHUB_INTEGRATION_ENABLED=true
# High-entropy secret key shared between TaskHub and this application (never commit actual secret)
TASKHUB_INTEGRATION_API_KEY=generate_with_crypto_random_bytes_64_hex
# Non-secret key identifier for audit tracking and key rotation
TASKHUB_INTEGRATION_KEY_ID=kallme-key-prod-01
# Comma-separated list of permitted resources: health,logs,inventory,billing,backups
TASKHUB_INTEGRATION_ALLOWED_RESOURCES=health,logs,inventory,billing,backups
# Application ID used in response envelope and telemetry
TASKHUB_APPLICATION_ID=kall-me
# Environment identifier: production, staging, development
TASKHUB_ENVIRONMENT=production

# TaskHub Central Error Reporting Configuration
TASKHUB_ERROR_REPORTING_ENABLED=false
TASKHUB_ERROR_INGESTION_URL=https://taskhub-console.example.com/api/errors/ingest
TASKHUB_ERROR_REPORTING_API_KEY=generate_taskhub_error_reporting_key

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=kallme_db
DB_PASSWORD=password
DB_PORT=5431

# TaskHub Integration Configuration
# Enable/disable integration endpoints (/api/integration/v1/*)
TASKHUB_INTEGRATION_ENABLED=true
# High-entropy secret key shared between TaskHub and this application (never commit actual secret)
TASKHUB_INTEGRATION_API_KEY=generate_with_crypto_random_bytes_64_hex
# Non-secret key identifier for audit tracking and key rotation
TASKHUB_INTEGRATION_KEY_ID=kallme-key-prod-01
# Comma-separated list of permitted resources: health,metrics,logs,traffic,deployments,inventory,billing,backups,diagnostics
TASKHUB_INTEGRATION_ALLOWED_RESOURCES=health,metrics,logs,traffic,deployments,inventory,billing,backups,diagnostics
# Application ID used in response envelope and telemetry
TASKHUB_APPLICATION_ID=kall-me
# Environment identifier: production, staging, development
TASKHUB_ENVIRONMENT=production

# TaskHub Error Reporting Configuration
# Central unhandled error forwarding (keep false until TaskHub endpoint is ready)
TASKHUB_ERROR_REPORTING_ENABLED=false
TASKHUB_ERROR_INGESTION_URL=https://taskhub-console.example.com/api/errors/ingest
TASKHUB_ERROR_REPORTING_API_KEY=generate_taskhub_error_reporting_key

